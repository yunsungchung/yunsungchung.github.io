---
layout: research
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <p class="eyebrow hero-eyebrow"><span class="status-dot" aria-hidden="true"></span> Machine learning for health</p>
    <h1 id="hero-title">
      Modeling patients.<br>
      Understanding <em>change.</em>
    </h1>
    <p class="hero-description">
      I build machine learning methods to represent patient state, forecast trajectories, and explore how care could unfold.
    </p>
    <p class="hero-affiliation">Yunsung Chung <span aria-hidden="true">/</span> PhD Candidate, Tulane University</p>
    <div class="hero-actions">
      <a class="button-primary" href="#research">Explore my research <span aria-hidden="true">↓</span></a>
      <a class="text-link" href="https://scholar.google.com/citations?user={{ site.data.socials.scholar_userid }}"
        >Google Scholar <span aria-hidden="true">↗</span></a
      >
    </div>
    <div class="hero-socials" aria-label="Contact and profiles">
      <a href="mailto:{{ site.data.socials.email }}">Email</a>
      <a href="https://github.com/{{ site.data.socials.github_username }}">GitHub <span aria-hidden="true">↗</span></a>
      <a href="https://www.linkedin.com/in/{{ site.data.socials.linkedin_username }}">LinkedIn <span aria-hidden="true">↗</span></a>
    </div>
  </div>
  <figure class="patient-figure">
    <div class="figure-topline"><span>A PATIENT, OVER TIME</span><span class="figure-index">FIG. 01</span></div>
    <svg class="patient-diagram" viewBox="0 0 480 370" role="img" aria-labelledby="patient-diagram-title patient-diagram-desc">
      <title id="patient-diagram-title">From multimodal observations to patient trajectories</title>
      <desc id="patient-diagram-desc">Health records, biosignals, and imaging contribute to a representation of patient state, which branches into possible future trajectories. This is a conceptual illustration, not measured patient data.</desc>
      <g class="diagram-grid"><path d="M30 44H450M30 94H450M30 144H450M30 194H450M30 244H450M30 294H450M80 24V330M160 24V330M240 24V330M320 24V330M400 24V330"/></g>
      <g class="input-node"><rect x="26" y="34" width="124" height="58" rx="7"/><rect x="178" y="34" width="124" height="58" rx="7"/><rect x="330" y="34" width="124" height="58" rx="7"/></g>
      <g class="diagram-input-label"><text x="88" y="58">EHR</text><text x="240" y="58">BIOSIGNALS</text><text x="392" y="58">IMAGING</text></g>
      <g class="observation-marks"><path d="M58 74H65M72 74H88M95 74H101M108 74H118M207 75H219L224 65L230 82L237 71L243 75H273"/><rect x="376" y="66" width="32" height="15" rx="3"/></g>
      <g class="input-connectors"><path d="M88 92V112Q88 126 102 126H222Q240 126 240 145M240 92V145M392 92V112Q392 126 378 126H258Q240 126 240 145"/></g>
      <rect class="state-box" x="151" y="145" width="178" height="62" rx="8"/>
      <text class="state-label" x="240" y="171">Patient state</text><text class="state-sublabel" x="240" y="190">a learned representation</text>
      <path class="trunk-line" d="M240 207V233"/>
      <g class="future-paths"><path class="future-one" d="M240 233C207 251 142 250 106 278S72 300 48 310"/><path class="future-two" d="M240 233C267 264 198 286 219 326"/><path class="future-three" d="M240 233C291 251 293 287 350 284S411 298 439 317"/></g>
      <circle class="branch-node" cx="240" cy="233" r="5"/>
      <g class="endpoint"><circle cx="48" cy="310" r="4"/><circle cx="219" cy="326" r="4"/><circle cx="439" cy="317" r="4"/></g>
      <text class="diagram-footer-label" x="240" y="362">FORECAST · SIMULATE · EVALUATE</text>
    </svg>
    <figcaption>
      From observations to possible futures.<br>
      <span>Conceptual illustration</span>
    </figcaption>
  </figure>
</section>

<section class="research-section" id="research" aria-labelledby="research-title">
  <div class="section-heading">
    <div>
      <p class="eyebrow">01 / Research</p>
      <h2 id="research-title">
        One question.<br>
        Connected directions.
      </h2>
    </div>
    <p class="section-intro">How can we build reliable models of patient state that predict, simulate, and inform research on clinical decisions?</p>
  </div>
  <ol class="research-process" aria-label="Research workflow">
    <li><span>01</span> Observe</li>
    <li><span>02</span> Represent</li>
    <li><span>03</span> Forecast</li>
    <li><span>04</span> Simulate</li>
    <li><span>05</span> Evaluate decisions</li>
  </ol>
  <div class="research-grid">
    {% bibliography --query @*[home_featured=true] --group_by none --template research-card %}
  </div>
  <p class="research-note">
    Across these projects, I focus on measurable questions in retrospective data: uncertainty, observation effects, and where models fail.
  </p>
</section>

<section class="publications-section" id="publications" aria-labelledby="publications-title">
  <div class="section-heading compact-heading">
    <div>
      <p class="eyebrow">02 / Publications</p>
      <h2 id="publications-title">Selected work</h2>
    </div>
    <a class="text-link" href="{{ '/publications/' | relative_url }}">All publications <span aria-hidden="true">↗</span></a>
  </div>
  <div class="home-publications">
    {% bibliography --query @*[selected=true] --group_by none --template home-publication %}
  </div>
</section>

<section class="about-section" id="about" aria-labelledby="about-title">
  <div class="about-portrait">
    <img src="{{ '/assets/img/prof_pic.jpg' | relative_url }}" alt="Yunsung Chung" width="600" height="600" loading="lazy" decoding="async">
    <p>Based in New Orleans, Louisiana</p>
  </div>
  <div class="about-copy">
    <p class="eyebrow">03 / About</p>
    <h2 id="about-title">
      Research across<br>
      data, models, and care.
    </h2>
    {{ content }}
    <a class="text-link" href="{{ site.data.socials.cv_pdf | relative_url }}">View my CV <span aria-hidden="true">↗</span></a>
  </div>
</section>

<aside class="research-tools" aria-labelledby="tools-title">
  <div>
    <p class="eyebrow">Tools for doing research</p>
    <h2 id="tools-title">ResearchWiki &amp; ResearchOMX</h2>
  </div>
  <p>Git- and Markdown-based tools connecting claims, evidence, and review, with scientific decisions kept in human hands.</p>
  <a class="text-link" href="{{ '/projects/researchwiki-researchomx/' | relative_url }}">Explore the tools <span aria-hidden="true">↗</span></a>
</aside>

<section class="news-section" aria-labelledby="news-title">
  <div class="section-heading compact-heading">
    <div>
      <p class="eyebrow">04 / Updates</p>
      <h2 id="news-title">Recent milestones</h2>
    </div>
    <a class="text-link" href="{{ '/news/' | relative_url }}">All news <span aria-hidden="true">↗</span></a>
  </div>
  <ol class="news-list">
    {% assign recent_news = site.news | reverse %}
    {% for item in recent_news limit: 5 %}
      <li>
        <time datetime="{% if item.date_precision == 'month' %}{{ item.date | date: '%Y-%m' }}{% else %}{{ item.date | date: '%Y-%m-%d' }}{% endif %}">
          {{- item.date | date: '%b %Y' -}}
        </time>
        <div>{{ item.content }}</div>
      </li>
    {% endfor %}
  </ol>
</section>

<section class="contact-section" aria-labelledby="contact-title">
  <p class="eyebrow">Let's connect</p>
  <h2 id="contact-title">Interested in similar questions?</h2>
  <p>I'm happy to discuss research collaborations and opportunities in machine learning for health.</p>
  <a class="text-link" href="mailto:{{ site.data.socials.email }}">
    {{- site.data.socials.email }}
    <span aria-hidden="true">↗</span></a
  >
</section>
